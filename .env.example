NODE_ENV=development
PORT=3001

# Use the existing replica-set URI as a server-side secret. Never put it in frontend code.
MONGODB_URI=mongodb://<username>:<password>@<mongo-host-1>:27017,<mongo-host-2>:27017,<mongo-host-3>:27017/?authSource=admin&replicaSet=rs0&retryWrites=true&w=majority
# Dedicated application database; must be granted readWrite access to the MongoDB service user.
SYSTEM_DATABASE_NAME=pantes_auth
SHIPMENT_SOURCE_DATABASE_NAME=db_pntspst2
MONGODB_MAX_POOL_SIZE=50


# Generate a private secret with: openssl rand -base64 48
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated exact origins. Leave empty for same-origin deployments.
CORS_ORIGINS=http://127.0.0.1:5173
# Trusted reverse-proxy addresses/CIDRs, comma-separated. Keep empty when directly exposed.
TRUST_PROXY=

# Agent AI uses DeepSeek Flash. Leave the key empty until the provider is ready.
# Add DEEPSEEK_API_KEY to backend/.env and restart the API to enable chat.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
AGENT_MAX_OUTPUT_TOKENS=20000
AGENT_GATEWAY_AUDIT_RETENTION_DAYS=30

# Legacy Encryptor.decryptascii key used to decode tm_dept.nama_dept values.
ENC_KEY_DEC=

# Optional gateway origin for balance/usage; defaults to the DEEPSEEK_BASE_URL origin.
DEEPSEEK_GATEWAY_URL=https://deepseek.nagatech.id

# Separate self-service credential generated in Gateway > Client & key.
DEEPSEEK_INTEGRATION_API_KEY=

# Allowed new top-up methods: qris,va | va | qris | empty disables all. Restart backend after changes.
TOPUP_PAYMENT_METHODS=qris,va


# Knowledge: MongoDB files/metadata + local embeddings + Qdrant
KNOWLEDGE_ENABLED=true
KNOWLEDGE_MAX_FILE_MB=20
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=pantes_knowledge_e5_v1
AGENT_HISTORY_QDRANT_COLLECTION=pantes_agent_history_e5_v1
EMBEDDING_MODEL=Xenova/multilingual-e5-small
EMBEDDING_REVISION=main
EMBEDDING_DIMENSIONS=384
EMBEDDING_CACHE_DIR=.cache/embeddings
# Shared business memory; set this key on the server, never in frontend.
HINDSIGHT_ENABLED=true
HINDSIGHT_BASE_URL=http://127.0.0.1:8888
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=pantes-shared-v1

# Extract durable user corrections from Agent chats; backfill saved chat history.
HINDSIGHT_AUTO_LEARN=true
HINDSIGHT_LEARN_HISTORY=true
